 "answer": "\\(x-1\\)",
 "methodPoints": [
  "平方差公式分解因式"
 ],
 "solution": "\\(\\frac{x^{2}-2}{x+1}+\\frac{1}{x+1}=\\frac{x^{2}-1}{x+1}\\)。\n\\(\\frac{x^{2}-1}{x+1}=\\frac{(x+1)(x-1)}{x+1}=x-1\\)。",
 "explanation": {
  "idea": "同分母分式相加，分子相加，结果再约分。",
  "hints": [
   "分子相加后还能分解因式吗？"
  ],
  "steps": [
   {
    "title": "相加",
    "body": "\\(\\frac{x^{2}-2}{x+1}+\\frac{1}{x+1}=\\frac{x^{2}-1}{x+1}\\)。"
   },
   {
    "title": "约分",
    "body": "\\(\\frac{x^{2}-1}{x+1}=\\frac{(x+1)(x-1)}{x+1}=x-1\\)。"
   }
  ],
  "check": "取 \\(x=2\\)：原式 \\(=\\frac23+\\frac13=1\\)，\\(x-1=1\\)。",
  "pitfalls": [
   "分子相加后停在 \\(\\frac{x^{2}-1}{x+1}\\)，没有约分。"
  ],
  "takeaway": "分式运算的结果要化到最简。"
 }
}
