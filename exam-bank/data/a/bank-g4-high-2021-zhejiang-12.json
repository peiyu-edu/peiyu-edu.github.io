  "hints": [
   "\\(\\sqrt6\\) 与 \\(2\\) 比，哪个大？"
  ],
  "steps": [
   {
    "title": "求内层",
    "body": "\\(\\sqrt6>\\sqrt4=2\\)，用第一段：\\(f(\\sqrt6)=6-4=2\\)。"
   },
   {
    "title": "求外层",
    "body": "\\(2\\le2\\)，用第二段：\\(f(2)=|2-3|+a=1+a\\)。"
   },
   {
    "title": "列方程",
    "body": "\\(1+a=3\\)，所以 \\(a=2\\)。"
   }
  ],
  "check": "\\(a=2\\) 时 \\(f(2)=1+2=3\\)，而 \\(f(\\sqrt6)=2\\)，所以 \\(f[f(\\sqrt6)]=3\\)，成立。",
