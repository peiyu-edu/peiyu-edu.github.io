  "steps": [
   {
    "title": "第一段",
    "body": "\\(x>0\\) 时，\\(y=2^x\\) 单调递增，\\(2^x>2^0=1\\)，值域为 \\((1,+\\infty)\\)。"
   },
   {
    "title": "第二段",
    "body": "\\(x\\le0\\) 时，\\(f(x)=1\\)，值域为 \\(\\{1\\}\\)。"
   },
   {
    "title": "取并集",
    "body": "\\((1,+\\infty)\\cup\\{1\\}=[1,+\\infty)\\)。"
   }
  ],
  "check": "\\(f(-1)=1\\)，\\(f(1)=2\\)，\\(f(3)=8\\)，都在 \\([1,+\\infty)\\) 内；没有小于 1 的函数值。",
  "pitfalls": [
