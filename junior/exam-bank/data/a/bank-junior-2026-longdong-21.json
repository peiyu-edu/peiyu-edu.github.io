  "steps": [
   {
    "title": "通分",
    "body": "\\(1-\\dfrac{1}{x+3}=\\dfrac{x+2}{x+3}\\)。"
   },
   {
    "title": "约分",
    "body": "原式\\(=\\dfrac{x+2}{x+3}\\cdot\\dfrac{(x+3)^2}{(x+2)(x-2)}=\\dfrac{x+3}{x-2}\\)。"
   },
   {
    "title": "代值",
    "body": "\\(x=4\\times\\dfrac{1}{2}+1=3\\)，原式\\(=\\dfrac{3+3}{3-2}=6\\)。"
   }
  ],
  "check": "把\\(x=3\\)代入原式：\\(\\left(1-\\dfrac{1}{6}\\right)\\div\\dfrac{5}{36}=\\dfrac{5}{6}\\times\\dfrac{36}{5}=6\\)。",
  "pitfalls": [
   "除法直接把分母分子各自相除，没有先化成乘法。"
  ],
