  "hints": [
   "\\(\\mathrm{i}^2=-1\\)，\\(\\mathrm{i}^3=\\mathrm{i}^2\\cdot\\mathrm{i}=-\\mathrm{i}\\)。",
   "\\(|a+b\\mathrm{i}|=\\sqrt{a^2+b^2}\\)。"
  ],
  "steps": [
   {
    "title": "化简",
    "body": "\\(2+\\mathrm{i}^2+2\\mathrm{i}^3=2-1-2\\mathrm{i}=1-2\\mathrm{i}\\)。"
   },
   {
    "title": "求模",
    "body": "\\(|1-2\\mathrm{i}|=\\sqrt{1^2+(-2)^2}=\\sqrt5\\)，选 C。"
   }
  ],
  "check": "\\((1-2\\mathrm{i})(1+2\\mathrm{i})=1+4=5\\)，模的平方是 5，模为 \\(\\sqrt5\\)。",
