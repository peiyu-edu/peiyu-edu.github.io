 "answer": "B",
 "methodPoints": [],
 "solution": "\\(\\dfrac{a_{k}}{b_{k}}=\\dfrac{a_{1}}{b_{1}}=\\dfrac{288}{192}=\\dfrac32\\)。\n\\(a_{3}=\\dfrac{a_{1}+a_{5}}{2}=\\dfrac{288+96}{2}=192\\)。\n\\(b_{3}=a_{3}\\div\\dfrac32=192\\times\\dfrac23=128\\)，选 B。",
 "explanation": {
  "idea": "比值是常数，就用 \\(k=1\\) 求出这个常数；再用等差中项求 \\(a_{3}\\)，除以常数得 \\(b_{3}\\)。",
  "hints": [
   "\\(a_{3}\\) 是 \\(a_{1}\\) 与 \\(a_{5}\\) 的等差中项。"
  ],
  "steps": [
   {
    "title": "求比值",
    "body": "\\(\\dfrac{a_{k}}{b_{k}}=\\dfrac{a_{1}}{b_{1}}=\\dfrac{288}{192}=\\dfrac32\\)。"
   },
   {
    "title": "求 a₃",
    "body": "\\(a_{3}=\\dfrac{a_{1}+a_{5}}{2}=\\dfrac{288+96}{2}=192\\)。"
   },
   {
    "title": "求 b₃",
    "body": "\\(b_{3}=a_{3}\\div\\dfrac32=192\\times\\dfrac23=128\\)，选 B。"
   }
  ],
  "check": "\\(b_{5}=96\\div\\dfrac32=64\\)，则 \\(b_{1},b_{3},b_{5}\\) 为 \\(192,128,64\\)，确实等差，与题设一致。",
  "pitfalls": [
   "把比值写反成 \\(\\dfrac23\\)，得出 \\(b_{3}=288\\) 一类的错误。",
   "误把 \\(\\{a_{n}\\}\\) 当成等比数列求 \\(a_{3}\\)。"
  ],
  "takeaway": "等差数列中下标成等差的三项，中间一项等于两端的平均数。"
 }
