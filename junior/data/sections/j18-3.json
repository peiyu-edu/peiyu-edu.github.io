      "steps": [
        {
          "title": "括号内通分",
          "body": "\\(1-\\dfrac{1}{x+2}=\\dfrac{x+2}{x+2}-\\dfrac{1}{x+2}=\\dfrac{x+1}{x+2}\\)。"
        },
        {
          "title": "除化乘",
          "body": "\\(\\dfrac{x+1}{x+2}\\div\\dfrac{x+1}{(x+2)^2}=\\dfrac{x+1}{x+2}\\cdot\\dfrac{(x+2)^2}{x+1}\\)。"
        },
        {
          "title": "约分",
          "body": "约去 \\(x+1\\) 和一个 \\(x+2\\)，得 \\(x+2\\)。"
        }
