  ],
  "steps": [
   {
    "title": "求 a₃",
    "body": "\\(S_5=\\dfrac{5(a_1+a_5)}{2}=5a_3\\)，由 \\(a_3=S_5\\) 得 \\(a_3=5a_3\\)，所以 \\(a_3=0\\)。"
   },
   {
    "title": "求公差",
    "body": "设公差为 \\(d\\ne0\\)，则 \\(a_2=-d\\)，\\(a_4=d\\)，\\(a_1=-2d\\)，\\(S_4=4a_1+6d=-2d\\)。由 \\(a_2a_4=S_4\\) 得 \\(-d^2=-2d\\)，因 \\(d\\ne0\\)，\\(d=2\\)。"
   },
   {
    "title": "（1）通项",
    "body": "\\(a_n=a_3+(n-3)d=2n-6\\)。"
   },
   {
    "title": "（2）列不等式",
    "body": "\\(S_n=\\dfrac{n(a_1+a_n)}{2}=\\dfrac{n(-4+2n-6)}{2}=n^2-5n\\)。\\(S_n>a_n\\iff n^2-5n>2n-6\\iff n^2-7n+6>0\\iff(n-1)(n-6)>0\\)。"
   },
   {
    "title": "（2）结论",
    "body": "\\(n\\) 为正整数，所以 \\(n>6\\)，最小值为 \\(7\\)。"
   }
