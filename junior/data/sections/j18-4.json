    "explanation": {
      "idea": "三项各有规则：零指数幂、负整数指数幂、算术平方根，先分别算出来再加减。",
      "hints": [
        "\\(3-\\pi\\) 等于 \\(0\\) 吗？",
        "\\(2^{-1}\\) 是 \\(2\\) 的什么？"
      ],
      "steps": [
        {
          "title": "零指数幂",
          "body": "\\(\\pi\\approx3.14\\)，\\(3-\\pi\\ne0\\)，所以 \\((3-\\pi)^0=1\\)。"
        },
        {
          "title": "负整数指数幂",
          "body": "\\(2^{-1}=\\dfrac{1}{2^1}=\\dfrac12\\)。"
        },
        {
          "title": "算术平方根",
          "body": "\\(\\left(\\dfrac12\\right)^2=\\dfrac14\\)，所以 \\(\\sqrt{\\dfrac14}=\\dfrac12\\)。"
        },
        {
          "title": "加减",
          "body": "原式 \\(=1-\\dfrac12+\\dfrac12=1\\)。"
        }
      ],
      "check": "后两项一减一加正好抵消，剩下零指数幂的 \\(1\\)。",
      "pitfalls": [
        "把 \\(2^{-1}\\) 当成 \\(-2\\)，算成 \\(1-(-2)+\\dfrac12=\\dfrac72\\)。",
        "把 \\((3-\\pi)^0\\) 当成 \\(0\\)，算成 \\(0-\\dfrac12+\\dfrac12=0\\)。"
      ],
      "takeaway": "负指数表示倒数：\\(a^{-1}=\\dfrac1a\\)；非零数的 \\(0\\) 次幂等于 \\(1\\)。"
    }
  },
