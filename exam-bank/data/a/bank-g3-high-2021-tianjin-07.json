 "answer": "C",
 "methodPoints": [],
 "solution": "\\(a\\lg2=1,b\\lg5=1\\)，所以 \\(1/a=\\lg2,1/b=\\lg5\\)。\n\\(1/a+1/b=\\lg2+\\lg5=\\lg10=1\\)，选 C。",
 "explanation": {
  "idea": "取常用对数后，倒数可直接表示为底数的常用对数。",
  "hints": [
   "对 \\(2^a=10\\) 两边取常用对数。"
  ],
  "steps": [
   {
    "title": "转化倒数",
    "body": "\\(a\\lg2=1,b\\lg5=1\\)，所以 \\(1/a=\\lg2,1/b=\\lg5\\)。"
   },
   {
    "title": "合并对数",
    "body": "\\(1/a+1/b=\\lg2+\\lg5=\\lg10=1\\)，选 C。"
   }
  ],
  "check": "a、b均为正，不为0，求倒数合法；对数相加对应真数相乘，不是真数相加。",
  "pitfalls": [
   "\\(\\lg2+\\lg5\\) 不是 \\(\\lg7\\)。"
  ],
  "takeaway": "指数等式中参数的倒数，可通过换底或取对数直接求出。"
 }
}
