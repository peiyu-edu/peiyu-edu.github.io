 "solution": "\\(z=\\frac{(1-\\mathrm{i})(2-2\\mathrm{i})}{(2+2\\mathrm{i})(2-2\\mathrm{i})}=\\frac{2-4\\mathrm{i}+2\\mathrm{i}^2}{8}=\\frac{-4\\mathrm{i}}{8}=-\\frac12\\mathrm{i}\\)。\n\\(\\overline z=\\frac12\\mathrm{i}\\)，\\(z-\\overline z=-\\mathrm{i}\\)，选 A。",
 "explanation": {
  "idea": "分母实数化求出 \\(z\\)，再用 \\(z-\\overline z=2\\mathrm{i}\\cdot\\) 虚部。",
  "hints": [
   "分子分母同乘 \\(2-2\\mathrm{i}\\)。"
  ],
  "steps": [
   {
    "title": "化简 z",
    "body": "\\(z=\\frac{(1-\\mathrm{i})(2-2\\mathrm{i})}{(2+2\\mathrm{i})(2-2\\mathrm{i})}=\\frac{2-4\\mathrm{i}+2\\mathrm{i}^2}{8}=\\frac{-4\\mathrm{i}}{8}=-\\frac12\\mathrm{i}\\)。"
   },
   {
    "title": "求差",
    "body": "\\(\\overline z=\\frac12\\mathrm{i}\\)，\\(z-\\overline z=-\\mathrm{i}\\)，选 A。"
   }
  ],
  "check": "\\(\\frac{1-\\mathrm{i}}{1+\\mathrm{i}}=-\\mathrm{i}\\)（因为 \\(-\\mathrm{i}(1+\\mathrm{i})=1-\\mathrm{i}\\)），再除以 2 得 \\(-\\frac12\\mathrm{i}\\)，一致。",
  "pitfalls": [
   "把 \\(\\mathrm{i}^2\\) 当成 1，得到 \\(z=\\frac{4-4\\mathrm{i}}{8}\\)。"
  ],
  "takeaway": "\\(z-\\overline z\\) 等于虚部的 2 倍乘以 \\(\\mathrm i\\)。"
