 "solution": "\\(\\bar z=2+\\mathrm{i}\\)，所以 \\(\\bar z+\\mathrm{i}=2+2\\mathrm{i}\\)。\n\\((2-\\mathrm{i})(2+2\\mathrm{i})=4+4\\mathrm{i}-2\\mathrm{i}-2\\mathrm{i}^2=6+2\\mathrm{i}\\)，选 C。",
 "explanation": {
  "idea": "先求括号里的 \\(\\bar z+\\mathrm{i}\\)，再与 \\(z\\) 相乘。",
  "hints": [
   "\\(z=a+b\\mathrm{i}\\) 的共轭是 \\(a-b\\mathrm{i}\\)。",
   "展开时用 \\(\\mathrm{i}^2=-1\\)。"
  ],
  "steps": [
   {
    "title": "求括号",
    "body": "\\(\\bar z=2+\\mathrm{i}\\)，所以 \\(\\bar z+\\mathrm{i}=2+2\\mathrm{i}\\)。"
   },
   {
    "title": "相乘",
    "body": "\\((2-\\mathrm{i})(2+2\\mathrm{i})=4+4\\mathrm{i}-2\\mathrm{i}-2\\mathrm{i}^2=6+2\\mathrm{i}\\)，选 C。"
   }
  ],
  "check": "另算：\\(z\\bar z=|z|^2=5\\)，\\(z\\cdot\\mathrm{i}=2\\mathrm{i}+1\\)，相加得 \\(6+2\\mathrm{i}\\)。",
  "pitfalls": [
   "把 \\(-2\\mathrm{i}^2\\) 当成 \\(-2\\)，会得到 \\(2+2\\mathrm{i}\\) 之类的错误结果。",
   "忘记先取共轭，直接用 \\(z+\\mathrm{i}\\) 计算。"
  ],
  "takeaway": "\\(z\\bar z=|z|^2\\) 是实数，可以用来简化含共轭的乘法。"
