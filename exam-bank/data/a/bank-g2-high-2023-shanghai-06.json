 "solution": "\\(i\\cdot z=i(1+i)=i+i^2=-1+i\\)。\n\\(1-i\\cdot z=1-(-1+i)=2-i\\)。\n\\(|2-i|=\\sqrt{2^2+(-1)^2}=\\sqrt5\\)。",
 "explanation": {
  "idea": "先把 \\(1-i\\cdot z\\) 化成 \\(x+yi\\) 的形式，再求模。",
  "hints": [
   "\\(i(1+i)=i+i^2\\)，而 \\(i^2=-1\\)。"
  ],
  "steps": [
   {
    "title": "算乘积",
    "body": "\\(i\\cdot z=i(1+i)=i+i^2=-1+i\\)。"
   },
   {
    "title": "做减法",
    "body": "\\(1-i\\cdot z=1-(-1+i)=2-i\\)。"
   },
   {
    "title": "求模",
    "body": "\\(|2-i|=\\sqrt{2^2+(-1)^2}=\\sqrt5\\)。"
   }
  ],
  "check": "用共轭复数验证：\\((2-i)(2+i)=4-i^2=5\\)，所以 \\(|2-i|^2=5\\)，模为 \\(\\sqrt5\\)。",
  "pitfalls": [
   "\\(i^2=-1\\)，不要算成 \\(+1\\)。",
   "减去 \\(-1+i\\) 时两项都要变号。"
  ],
  "takeaway": "复数求模先化成代数形式 \\(x+yi\\)。"
 }
