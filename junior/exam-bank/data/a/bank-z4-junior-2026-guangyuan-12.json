 "solution": "\\((3m+5n)-(2m+6n)=m-n\\)。\n由 \\(m>n\\) 得 \\(m-n>0\\)，所以 \\(3m+5n>2m+6n\\)，填“\\(>\\)”。",
 "explanation": {
  "idea": "两个式子作差，看差的正负。",
  "hints": [
   "算一算 \\((3m+5n)-(2m+6n)\\) 等于什么。"
  ],
  "steps": [
   {
    "title": "作差",
    "body": "\\((3m+5n)-(2m+6n)=m-n\\)。"
   },
   {
    "title": "判断符号",
    "body": "由 \\(m>n\\) 得 \\(m-n>0\\)，所以 \\(3m+5n>2m+6n\\)，填“\\(>\\)”。"
   }
  ],
  "check": "取 \\(m=1,n=0\\)：\\(3>2\\)，结论一致。",
  "pitfalls": [
   "作差时把 \\(5n-6n\\) 算成 \\(n\\)。"
  ],
  "takeaway": "比较两个代数式的大小，常用作差后判断符号。"
 }
