  "steps": [
   {
    "title": "求顶点",
    "body": "\\(y=(x-m)^{2}+1\\)，顶点\\((m,1)\\)，\\(l\\)为\\(y=1\\)。"
   },
   {
    "title": "表示边长",
    "body": "令\\((x-m)^{2}+1=a\\)，\\(x=m\\pm\\sqrt{a-1}\\)，所以\\(AB=2\\sqrt{a-1}\\)；\\(AM=a-1\\)。"
   },
   {
    "title": "列方程",
    "body": "\\(a-1=2\\sqrt{a-1}\\)。由于交于两点，\\(a>1\\)，两边约去\\(\\sqrt{a-1}\\)得\\(\\sqrt{a-1}=2\\)，\\(a=5\\)。"
   }
  ],
  "check": "\\(a=5\\)时\\(AB=2\\times 2=4\\)，\\(AM=5-1=4\\)，相等。",
