 ],
 "solution": "\\(a=3,b=\\sqrt6,c=\\sqrt3\\)，\\(m+n=6\\)，\\(|F_1F_2|=2\\sqrt3\\)。\n\\(12=m^2+n^2-\\frac65mn=(m+n)^2-\\frac{16}{5}mn=36-\\frac{16}{5}mn\\)，得 \\(mn=\\frac{15}{2}\\)。\n\\(4|PO|^2=m^2+n^2+2mn\\cdot\\frac35=(36-15)+9=30\\)，\\(|PO|=\\frac{\\sqrt{30}}{2}\\)，选 B。",
 "explanation": {
  "idea": "\\(PO\\) 是 \\(\\triangle F_1PF_2\\) 的中线，用 \\(\\overrightarrow{PO}=\\frac12(\\overrightarrow{PF_1}+\\overrightarrow{PF_2})\\)。",
  "hints": [
   "设 \\(|PF_1|=m,|PF_2|=n\\)，先用定义和余弦定理求 \\(mn\\)。"
  ],
  "steps": [
   {
    "title": "基本量",
    "body": "\\(a=3,b=\\sqrt6,c=\\sqrt3\\)，\\(m+n=6\\)，\\(|F_1F_2|=2\\sqrt3\\)。"
   },
   {
    "title": "求 mn",
    "body": "\\(12=m^2+n^2-\\frac65mn=(m+n)^2-\\frac{16}{5}mn=36-\\frac{16}{5}mn\\)，得 \\(mn=\\frac{15}{2}\\)。"
   },
   {
    "title": "求 PO",
    "body": "\\(4|PO|^2=m^2+n^2+2mn\\cdot\\frac35=(36-15)+9=30\\)，\\(|PO|=\\frac{\\sqrt{30}}{2}\\)，选 B。"
   }
  ],
  "check": "\\(|PO|\\) 应在 \\(b=\\sqrt6\\approx2.45\\) 与 \\(a=3\\) 之间，\\(\\frac{\\sqrt{30}}{2}\\approx2.74\\)，合理。",
  "pitfalls": [
   "\\(m^2+n^2=(m+n)^2-2mn=21\\)，不要直接写成 \\(36\\)。"
  ],
  "takeaway": "焦点三角形问题常把 \\(m+n\\) 和 \\(mn\\) 当作整体来求。"
 }
}
