    "title": "（1）逐项求值",
    "body": "\\(\\sqrt4=2\\)，\\((\\sqrt2+1)^0=1\\)，\\(\\tan45^{\\circ}=1\\)，原式 \\(=2-1+1=2\\)。"
   },
   {
    "title": "（2）通分",
    "body": "\\(\\dfrac1{x+1}+\\dfrac1{x-1}=\\dfrac{(x-1)+(x+1)}{(x+1)(x-1)}=\\dfrac{2x}{(x+1)(x-1)}\\)。"
   },
   {
    "title": "（2）约分",
    "body": "\\(\\dfrac{2x}{(x+1)(x-1)}\\cdot\\dfrac{x-1}{x}=\\dfrac{2}{x+1}\\)。"
   }
