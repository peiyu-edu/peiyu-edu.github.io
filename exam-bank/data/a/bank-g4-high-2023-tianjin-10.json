 "solution": "\\(\\dfrac{5+14\\mathrm{i}}{2+3\\mathrm{i}}=\\dfrac{(5+14\\mathrm{i})(2-3\\mathrm{i})}{(2+3\\mathrm{i})(2-3\\mathrm{i})}\\)，分母为 \\(4+9=13\\)。\n\\((5+14\\mathrm{i})(2-3\\mathrm{i})=10-15\\mathrm{i}+28\\mathrm{i}-42\\mathrm{i}^{2}=52+13\\mathrm{i}\\)。\n\\(\\dfrac{52+13\\mathrm{i}}{13}=4+\\mathrm{i}\\)。",
 "explanation": {
  "idea": "分子分母同乘分母的共轭复数，把分母化成实数。",
  "hints": [
   "\\((2+3\\mathrm{i})(2-3\\mathrm{i})=2^{2}+3^{2}\\)。"
  ],
  "steps": [
   {
    "title": "乘共轭",
    "body": "\\(\\dfrac{5+14\\mathrm{i}}{2+3\\mathrm{i}}=\\dfrac{(5+14\\mathrm{i})(2-3\\mathrm{i})}{(2+3\\mathrm{i})(2-3\\mathrm{i})}\\)，分母为 \\(4+9=13\\)。"
   },
   {
    "title": "展开分子",
    "body": "\\((5+14\\mathrm{i})(2-3\\mathrm{i})=10-15\\mathrm{i}+28\\mathrm{i}-42\\mathrm{i}^{2}=52+13\\mathrm{i}\\)。"
   },
   {
    "title": "化简",
    "body": "\\(\\dfrac{52+13\\mathrm{i}}{13}=4+\\mathrm{i}\\)。"
   }
  ],
  "check": "反乘验证：\\((4+\\mathrm{i})(2+3\\mathrm{i})=8+12\\mathrm{i}+2\\mathrm{i}+3\\mathrm{i}^{2}=5+14\\mathrm{i}\\)。",
