      "j17-1"
    ],
    "explanation": {
      "idea": "三项、首尾是平方：检查中间项是不是 2 倍积，是就用完全平方公式。",
      "hints": [
        "\\(9\\) 是谁的平方？",
        "\\(2\\cdot x\\cdot3\\) 等于多少？和中间项一样吗？"
      ],
      "steps": [
        {
          "title": "认形状",
          "body": "\\(x^2=x^2\\)，\\(9=3^2\\)，\\(2\\cdot x\\cdot3=6x\\)，中间项正是 \\(-6x\\)。"
        },
        {
          "title": "套公式",
          "body": "\\(a^2-2ab+b^2=(a-b)^2\\)，\\(a=x,\\ b=3\\)：\\(x^2-6x+9=(x-3)^2\\)。"
        }
      ],
      "check": "乘回去：\\((x-3)^2=x^2-6x+9\\) ✓。",
      "pitfalls": [
        "符号跟错，写成 \\((x+3)^2\\)，乘开是 \\(x^2+6x+9\\)。",
        "当成平方差，写成 \\((x+3)(x-3)\\)，乘开是 \\(x^2-9\\)。"
      ],
      "takeaway": "中间项是负的，括号里就写减号；常数项 \\(9\\) 仍是正的。"
    }
  },
