      ],
      "steps": [
        {
          "title": "先乘方",
          "body": "\\((-a)^2=a^2\\)。"
        },
        {
          "title": "再相乘",
          "body": "\\(3a^2b\\cdot a^2=3\\cdot a^{2+2}\\cdot b=3a^4b\\)。"
